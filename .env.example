# Copia a .env.local (no se versiona) o exporta en la terminal. Playwright no carga .env solo:
#   set -a; . ./.env.local; set +a
# Nunca escribas aquí valores reales: la contraseña de demo se lee del servidor (ver README).

# Backend (por defecto, el de desarrollo)
E2E_API_ORIGIN=https://136.243.223.39.sslip.io

# Personas de demostración de la semilla del backend (SEED_DEMO_PASSWORD) y secreto TOTP del
# personal de plataforma (Ola 1)
E2E_PASSWORD=change-me
E2E_TOTP_SECRET=change-me

# Apps: URL ya levantadas (si faltan, http://localhost:<puerto> y E2E_START_APPS=1 las arranca)
# E2E_URL_ERP=http://localhost:3102
# E2E_URL_BACKOFFICE=http://localhost:3103
# E2E_START_APPS=1
# E2E_APPS=erp,backoffice
# E2E_REF_ERP=dev
# E2E_REF_BACKOFFICE=dev
# E2E_APP_DIR_ERP=../drinks-on-chain-erp   # construir y servir una carpeta tal cual (sustituye su .next)

# Proyectos de olas futuras (desactivados por defecto)
# E2E_ENABLE_MARKETPLACE=1
# E2E_ENABLE_POS=1
# E2E_ENABLE_BODEGAS=1

# Buzón (Mailpit del servidor). Local: ssh normal que ejecuta curl en el servidor
E2E_MAILPIT_SSH=drinksonchain-server
# E2E_MAILPIT_SSH_MODE=curl            # api = llave de comando forzado (CI)
# E2E_MAILPIT_SSH_KEY=~/.ssh/e2e_mailpit
# E2E_MAILPIT_URL=http://127.0.0.1:8025  # alternativa: túnel ssh -L 8025:127.0.0.1:8025
# E2E_KEEP_MAIL=1                        # no borrar los correos de la ejecución al terminar

# Otros
# E2E_RUN_ID=e2e-20260927t1630-abcd    # repetir con un prefijo fijo
# E2E_WORKERS=1
# E2E_CAPTCHA_TOKEN=XXXX.DUMMY.TOKEN.XXXX
# E2E_BROWSER_CHANNEL=chrome
